# Build / packaging artifacts
build/
dist/
__pycache__/
*.pyc

# Personal run data & outputs
selections/
patches/
sprint_toolkit/out/
magnitude_presets.json
magnitude_presets.json.*
settings.json 
settings.json.*
map_pool_hashes.json
map_pool_hashes.json.tmp

# Manual backups & scratch copies
halo_enhancer_backup*.py
halo_enhancer*_backup*.py
*_backup*_WORKING.py
halo - Copy*.json
halo.json.bak
halo_enhancer.txt
halo_enhancer - Copy.py

# DeepSeek scratch exports
deepseek_*

# .exe build tooling (not needed to run the Python tool)
build.bat
*.spec
# ...except the exe recipe itself: it bundles port_glyphs.json + h3_font_repack, without
# which a built Enhancer cannot restore the weapon ports' icons on other machines
!halo_enhancer.spec

# Reference material / not part of the main tool
*.ods
test_gui.py
skull_bg.png
bane_bg.png

# Side backups of live maps made by the H4 test tools (1 GB each)
sprint_toolkit/_scope_test_backup/
sprint_toolkit/_pools_backup/

# derived art from the Halo 1 build (make_icon.py, ammo_meter.py previews)
sprint_toolkit/h1mp/

# Restore points the Halo 1 build makes beside itself (stock copies, per machine)
sprint_toolkit/*.scenario.before_saw
sprint_toolkit/*.map.before_saw
sprint_toolkit/*.bitmap.stock

# Stale test-folder settings export (to be deleted)
settings_from_test_folder.json
h1_actv_index.json
port_levels_cache.json

# weapon-port listening samples (decoded game audio)
sprint_toolkit/sound_compare/
